{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Angular",
      "type": "editor-browser",
      "request": "launch",
      "preLaunchTask": "npm: start",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}/src/web/client",
      "sourceMapPathOverrides": {
        "webpack:///./src/*": "${webRoot}/*"
      },
    }
  ],
  "compounds": [
    {
      "name": "Full Stack",
      "configurations": [
        "Debug Angular"
      ]
    }
  ]
}