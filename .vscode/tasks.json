{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: start",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}/src/web/client"
      },
      "isBackground": true,
      "presentation": {
        "close": true
      },
      "problemMatcher": {
        "owner": "angular",
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building\\.\\.\\.|Application bundle generation",
          "endsPattern": "Local:\\s+http://localhost:4200/"
        }
      }
    },
    {
      "label": "api: build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/web/api/GarethDuncanDevWebApi/GarethDuncanDevWebApi.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}