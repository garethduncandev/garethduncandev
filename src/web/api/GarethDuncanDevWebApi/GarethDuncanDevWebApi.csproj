<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <AssemblyName>bootstrap</AssemblyName>

    <!-- Enforces strict build-time validation for your API endpoints -->
    <EnableAotAnalyzer>true</EnableAotAnalyzer>

    <!-- Emits explicit warnings if any dependency uses AOT-breaking reflection -->
    <IllinkConstraints>true</IllinkConstraints>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="Embeddings\blog-embedded.json" />
    <Content Remove="Embeddings\notes-embedded.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.APIGatewayEvents" Version="3.0.0" />
    <PackageReference Include="Amazon.Lambda.Serialization.SystemTextJson" Version="3.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Amazon.Lambda.AspNetCoreServer.Hosting" Version="1.10.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Embeddings\blog-embedded.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Embeddings\notes-embedded.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GarethDuncanDev.Search\GarethDuncanDev.Search.csproj" />
  </ItemGroup>

</Project>
